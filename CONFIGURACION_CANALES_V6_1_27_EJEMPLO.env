# TMAD v6.1.27 · Discord · canales semánticos + control EXECUTION
# Copia las URLs/credenciales reales a 02_CONFIG\configuracion_canales.env.
# Este ejemplo NO contiene secretos reales.

# DATA
DATA_LOG_WEBHOOK=
DATA_QUALITY_WEBHOOK=
DATA_ERROR_WEBHOOK=

# ALERTS
ALERTS_RESEARCH_WEBHOOK=
ALERTS_SHADOW_WEBHOOK=
ALERTS_LIVE_WEBHOOK=
ALERTS_POSITIONS_WEBHOOK=
ALERTS_LOG_WEBHOOK=
ALERTS_ERROR_WEBHOOK=

# MODEL
MODEL_CALIBRATION_WEBHOOK=
MODEL_LEARNING_WEBHOOK=

# SYSTEM
SYSTEM_STATUS_WEBHOOK=

# CONTROL REMOTO SEGURO
# El webhook identifica el canal EXECUTION y publica ahí el resultado.
# DISCORD_TOKEN permite al controlador local leer exclusivamente ese canal.
EXECUTION_WEBHOOK=
DISCORD_TOKEN=

# Compatibilidad de migración (mismo significado, no fallback cruzado):
# DATA_SCHEMA_WEBHOOK -> DATA_QUALITY_WEBHOOK
# DAILY_CALIBRATION_WEBHOOK -> MODEL_CALIBRATION_WEBHOOK
# LEARNING_AUDIT_WEBHOOK -> MODEL_LEARNING_WEBHOOK
# ALERTS_STATUS_WEBHOOK -> SYSTEM_STATUS_WEBHOOK
