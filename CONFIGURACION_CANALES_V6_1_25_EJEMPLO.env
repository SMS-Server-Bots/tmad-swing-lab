# TMAD v6.1.25 · Discord · 10 canales semánticos
# Copia SOLO las URLs a 02_CONFIG\configuracion_canales.env.
# Este archivo de ejemplo no contiene secretos reales.

# TMAD · SYSTEM
DATA_LOG_WEBHOOK=
DATA_QUALITY_WEBHOOK=
DATA_ERROR_WEBHOOK=
ALERTS_STATUS_WEBHOOK=
ALERTS_ERROR_WEBHOOK=

# TMAD · MODELS
DAILY_CALIBRATION_WEBHOOK=
LEARNING_AUDIT_WEBHOOK=

# TMAD · SIGNALS
ALERTS_RESEARCH_WEBHOOK=
ALERTS_SHADOW_WEBHOOK=
ALERTS_LIVE_WEBHOOK=

# Compatibilidad v6.1.24:
# DATA_SCHEMA_WEBHOOK puede coexistir temporalmente; DATA_QUALITY_WEBHOOK tiene prioridad.
# ALERTS_LOG_WEBHOOK puede coexistir temporalmente; ALERTS_STATUS_WEBHOOK tiene prioridad.
# Si ALERTS_SHADOW_WEBHOOK falta, v6.1.25 usa Research como fallback.
# Si LEARNING_AUDIT_WEBHOOK falta, v6.1.25 usa Calibration como fallback.
