diff --git a/01_PROGRAMAS/data_bot/flow_capture.py b/01_PROGRAMAS/data_bot/flow_capture.py
new file mode 100644
index 0000000..6705f5d
--- /dev/null
+++ b/01_PROGRAMAS/data_bot/flow_capture.py
@@ -0,0 +1,413 @@
+"""Captura de flujo para FLOW_DB (tmad_flow_live.db).
+
+Guarda lo que tmad.app publica pero no conserva histórico y el bot no guardaba:
+
+* ``/api/stock/{t}/option-heatmap?side=call|put``: por contrato, volumen, OI, cambio de OI frente a la
+  sesión anterior, cambio de GEX e IV. TMAD solo sirve la última foto, así que se captura una vez al día
+  (antes de la apertura, cuando la foto "daily" de la sesión anterior ya está cerrada).
+* ``/api/score/regime``: acierto móvil del top-10 del Score a 5 y 10 días que publica TMAD.
+* ``/api/stock/{t}/intraday?days=30``: velas de 1 min con pre/post-market. Incremental por ticker, solo
+  sesiones completas; una vez por semana basta porque la ventana es de 30 días.
+
+Se ejecuta en un hilo propio con su propio cliente HTTP para no bloquear el Scanner ni el GEX.
+Escribe solo en FLOW_DB. El archivo semanal la copia como ``flow_<semana>.sqlite``.
+"""
+from __future__ import annotations
+
+import json
+import threading
+import time
+import traceback
+import zlib
+from datetime import datetime, timedelta
+
+import config
+from db_core import connect, ensure_flow_schema
+from time_utils import MARKET_TZ, now_madrid, ts_madrid_str, ts_utc_str
+
+CODEC = "json-columnar+zlib"
+HEATMAP_FIELDS = ("strike", "dte", "openInterest", "oiChange", "volume", "impliedVolatility", "gex", "gexChange")
+BAR_FIELDS = ("open", "high", "low", "close", "volume")
+
+_lock = threading.Lock()
+_thread: threading.Thread | None = None
+
+
+def _log(msg: str) -> None:
+    print(f"[flow] {msg}", flush=True)
+
+
+def _pack(columns: dict) -> bytes:
+    return zlib.compress(json.dumps(columns, separators=(",", ":")).encode("utf-8"), 6)
+
+
+def unpack(blob: bytes) -> dict:
+    """Inverso de _pack, para análisis: devuelve {campo: [valores...]}."""
+    return json.loads(zlib.decompress(blob).decode("utf-8"))
+
+
+def _num(x):
+    try:
+        if x is None:
+            return None
+        v = float(x)
+        return v if v == v else None
+    except (TypeError, ValueError):
+        return None
+
+
+def _get(client, url: str):
+    from tmad_client import fetch_json_with_retries
+
+    payload, status = fetch_json_with_retries(client, url)
+    if config.FLOW_HTTP_SLEEP_SECONDS:
+        time.sleep(config.FLOW_HTTP_SLEEP_SECONDS)
+    return payload, status
+
+
+# --------------------------------------------------------------------------- universo
+
+def universe_tickers() -> list[str]:
+    """Tickers del último Scanner con éxito (sin pedir el Scanner otra vez)."""
+    conn = connect(config.SCANNER_DB)
+    try:
+        row = conn.execute("SELECT id FROM scanner_runs WHERE status='success' ORDER BY id DESC LIMIT 1").fetchone()
+        if not row:
+            return []
+        rows = conn.execute(
+            "SELECT DISTINCT ticker FROM scanner_snapshots WHERE scanner_run_id=? AND ticker IS NOT NULL", (int(row[0]),)
+        ).fetchall()
+        return sorted({str(r[0]).upper() for r in rows if r[0]})
+    finally:
+        conn.close()
+
+
+# --------------------------------------------------------------------------- run bookkeeping
+
+def _start_run(kind: str, slot_key: str, total: int) -> int:
+    conn = connect(config.FLOW_DB)
+    try:
+        cur = conn.execute(
+            "INSERT INTO flow_runs(kind,slot_key,captured_at_utc,captured_at_madrid,status,tickers_total) VALUES (?,?,?,?,?,?)",
+            (kind, slot_key, ts_utc_str(), ts_madrid_str(), "running", total),
+        )
+        conn.commit()
+        return int(cur.lastrowid)
+    finally:
+        conn.close()
+
+
+def _finish_run(run_id: int, status: str, ok: int, failed: int, rows: int, nbytes: int, error: str | None = None) -> None:
+    conn = connect(config.FLOW_DB)
+    try:
+        conn.execute(
+            "UPDATE flow_runs SET status=?,finished_at_madrid=?,tickers_ok=?,tickers_failed=?,rows_written=?,bytes_written=?,error_message=? WHERE id=?",
+            (status, ts_madrid_str(), ok, failed, rows, nbytes, (error or "")[:1000] or None, run_id),
+        )
+        conn.commit()
+    finally:
+        conn.close()
+
+
+def _done(kind: str, slot_key: str) -> bool:
+    conn = connect(config.FLOW_DB)
+    try:
+        return conn.execute(
+            "SELECT 1 FROM flow_runs WHERE kind=? AND slot_key=? AND status IN ('success','partial') LIMIT 1", (kind, slot_key)
+        ).fetchone() is not None
+    finally:
+        conn.close()
+
+
+def _last_success_age_days(kind: str) -> float | None:
+    conn = connect(config.FLOW_DB)
+    try:
+        row = conn.execute(
+            "SELECT max(captured_at_madrid) FROM flow_runs WHERE kind=? AND status IN ('success','partial')", (kind,)
+        ).fetchone()
+    finally:
+        conn.close()
+    if not row or not row[0]:
+        return None
+    try:
+        last = datetime.fromisoformat(str(row[0]))
+        return (now_madrid() - last).total_seconds() / 86400.0
+    except Exception:
+        return None
+
+
+# --------------------------------------------------------------------------- option heatmap
+
+def summarize_heatmap(snapshot: dict, max_dte: int, max_moneyness: float) -> tuple[dict, dict]:
+    """Devuelve (resumen, columnas filtradas) de una foto del mapa de calor."""
+    contracts = snapshot.get("contracts") or []
+    spot = _num(snapshot.get("spot"))
+    kept = []
+    s = {"oi_total": 0.0, "oi_change_total": 0.0, "oi_change_otm": 0.0, "oi_change_near_otm": 0.0,
+         "volume_total": 0.0, "volume_otm": 0.0, "gex_change_total": 0.0}
+    top = None
+    for c in contracts:
+        if not isinstance(c, dict):
+            continue
+        oi = _num(c.get("openInterest")) or 0.0
+        doi = _num(c.get("oiChange")) or 0.0
+        vol = _num(c.get("volume")) or 0.0
+        dg = _num(c.get("gexChange")) or 0.0
+        dte = _num(c.get("dte"))
+        strike = _num(c.get("strike"))
+        otm = bool(c.get("otm"))
+        s["oi_total"] += oi; s["oi_change_total"] += doi; s["volume_total"] += vol; s["gex_change_total"] += dg
+        if otm:
+            s["oi_change_otm"] += doi; s["volume_otm"] += vol
+            if dte is not None and dte <= 45:
+                s["oi_change_near_otm"] += doi
+        if top is None or abs(doi) > abs(top[2]):
+            top = (strike, int(dte) if dte is not None else None, doi)
+        if spot and strike and dte is not None and dte <= max_dte and abs(strike / spot - 1.0) <= max_moneyness:
+            kept.append(c)
+    cols = {f: [c.get(f) for c in kept] for f in HEATMAP_FIELDS}
+    cols["otm"] = [1 if c.get("otm") else 0 for c in kept]
+    s.update({
+        "contracts_total": len(contracts), "contracts_kept": len(kept),
+        "top_oi_change_strike": top[0] if top else None, "top_oi_change_dte": top[1] if top else None,
+        "top_oi_change": top[2] if top else None,
+    })
+    return s, cols
+
+
+def capture_option_heatmaps(client, tickers: list[str], slot_key: str) -> dict:
+    run_id = _start_run("option_heatmap", slot_key, len(tickers))
+    ok = failed = rows = nbytes = 0
+    errors: list[str] = []
+    conn = connect(config.FLOW_DB)
+    try:
+        for i, t in enumerate(tickers, 1):
+            t_ok = True
+            for side in ("call", "put"):
+                try:
+                    url = config.OPTION_HEATMAP_URL_TEMPLATE.format(ticker=t, side=side)
+                    payload, _st = _get(client, url)
+                    snap = (payload or {}).get("snapshot") or {}
+                    if not snap.get("contracts"):
+                        continue
+                    summ, cols = summarize_heatmap(snap, config.OPTION_HEATMAP_MAX_DTE, config.OPTION_HEATMAP_MAX_MONEYNESS)
+                    blob = _pack(cols)
+                    conn.execute(
+                        """INSERT OR REPLACE INTO option_heatmap_snapshots(
+                            flow_run_id,captured_at_utc,captured_at_madrid,ticker,side,mode,session_date,previous_session_date,
+                            source_captured_at,spot,gex_complete,total_otm_gex,contracts_total,contracts_kept,oi_total,
+                            oi_change_total,oi_change_otm,oi_change_near_otm,volume_total,volume_otm,gex_change_total,
+                            top_oi_change_strike,top_oi_change_dte,top_oi_change,contracts_codec,contracts_blob)
+                           VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)""",
+                        (run_id, ts_utc_str(), ts_madrid_str(), t, side, payload.get("mode"), snap.get("sessionDate"),
+                         snap.get("previousSessionDate"), snap.get("capturedAt"), _num(snap.get("spot")),
+                         1 if snap.get("gexComplete") else 0, _num(snap.get("totalOtmGex")), summ["contracts_total"],
+                         summ["contracts_kept"], summ["oi_total"], summ["oi_change_total"], summ["oi_change_otm"],
+                         summ["oi_change_near_otm"], summ["volume_total"], summ["volume_otm"], summ["gex_change_total"],
+                         summ["top_oi_change_strike"], summ["top_oi_change_dte"], summ["top_oi_change"], CODEC, blob),
+                    )
+                    rows += 1; nbytes += len(blob)
+                except Exception as e:  # noqa: BLE001
+                    t_ok = False
+                    if len(errors) < 20:
+                        errors.append(f"{t}/{side}: {type(e).__name__}: {str(e)[:120]}")
+            ok += 1 if t_ok else 0
+            failed += 0 if t_ok else 1
+            if i % 50 == 0:
+                conn.commit()
+                _log(f"heatmap {i}/{len(tickers)} ok={ok} failed={failed} rows={rows} {nbytes/1e6:.1f} MB")
+        conn.commit()
+    finally:
+        conn.close()
+    status = "success" if failed == 0 else ("partial" if ok > 0 else "failed")
+    _finish_run(run_id, status, ok, failed, rows, nbytes, "; ".join(errors) if errors else None)
+    return {"run_id": run_id, "status": status, "ok": ok, "failed": failed, "rows": rows, "mb": round(nbytes / 1e6, 1)}
+
+
+# --------------------------------------------------------------------------- score regime
+
+def capture_score_regime(client, slot_key: str) -> dict:
+    run_id = _start_run("score_regime", slot_key, 1)
+    rows = 0
+    try:
+        payload, _st = _get(client, config.SCORE_REGIME_URL)
+        windows = ((payload or {}).get("data") or {}).get("windows") or {}
+        conn = connect(config.FLOW_DB)
+        try:
+            for w, block in windows.items():
+                hist = list((block or {}).get("history") or [])
+                cur = (block or {}).get("current")
+                if isinstance(cur, dict):
+                    hist.append(cur)
+                for r in hist:
+                    if not isinstance(r, dict) or not r.get("date"):
+                        continue
+                    conn.execute(
+                        """INSERT OR REPLACE INTO score_regime_daily(flow_run_id,captured_at_madrid,window_days,regime_date,
+                           lists_count,wins,win_rate,short_win_rate,avg_return,spy_return,alpha) VALUES (?,?,?,?,?,?,?,?,?,?,?)""",
+                        (run_id, ts_madrid_str(), int(w), r.get("date"), r.get("count"), r.get("wins"), _num(r.get("winRate")),
+                         _num(r.get("shortWinRate")), _num(r.get("avgReturn")), _num(r.get("spyReturn")), _num(r.get("alpha"))),
+                    )
+                    rows += 1
+            conn.commit()
+        finally:
+            conn.close()
+        _finish_run(run_id, "success", 1, 0, rows, 0)
+        return {"status": "success", "rows": rows}
+    except Exception as e:  # noqa: BLE001
+        _finish_run(run_id, "failed", 0, 1, rows, 0, f"{type(e).__name__}: {e}")
+        return {"status": "failed", "error": str(e)[:200]}
+
+
+# --------------------------------------------------------------------------- intraday 1-min bars
+
+def _cursors() -> dict[str, str]:
+    conn = connect(config.FLOW_DB)
+    try:
+        return {str(r[0]): str(r[1]) for r in conn.execute("SELECT ticker,last_ts FROM intraday_bars_cursor").fetchall()}
+    finally:
+        conn.close()
+
+
+def capture_intraday_bars(client, tickers: list[str], slot_key: str) -> dict:
+    """Guarda las velas de sesiones completas (fecha de NY < hoy) posteriores al cursor de cada ticker."""
+    run_id = _start_run("intraday_bars_1m", slot_key, len(tickers))
+    today_ny = datetime.now(MARKET_TZ).strftime("%Y-%m-%d")
+    cursors = _cursors()
+    ok = failed = rows = nbytes = 0
+    errors: list[str] = []
+    conn = connect(config.FLOW_DB)
+    try:
+        for i, t in enumerate(tickers, 1):
+            try:
+                url = config.STOCK_INTRADAY_URL_TEMPLATE.format(ticker=t)
+                payload, _st = _get(client, url)
+                data = (payload or {}).get("data", payload) or {}
+                bars = data.get("intradayBars") or []
+                last = cursors.get(t, "")
+                new = [b for b in bars if isinstance(b, dict) and str(b.get("timestamp") or "") > last
+                       and str(b.get("timestamp") or "")[:10] < today_ny]
+                new.sort(key=lambda b: str(b.get("timestamp")))
+                if new:
+                    cols = {"ts": [str(b.get("timestamp")) for b in new]}
+                    for f in BAR_FIELDS:
+                        cols[f] = [b.get(f) for b in new]
+                    blob = _pack(cols)
+                    first_ts, last_ts = cols["ts"][0], cols["ts"][-1]
+                    sessions = len({ts[:10] for ts in cols["ts"]})
+                    conn.execute(
+                        """INSERT OR REPLACE INTO intraday_bars_1m(flow_run_id,captured_at_utc,captured_at_madrid,ticker,first_ts,
+                           last_ts,bars,sessions,bars_codec,bars_blob) VALUES (?,?,?,?,?,?,?,?,?,?)""",
+                        (run_id, ts_utc_str(), ts_madrid_str(), t, first_ts, last_ts, len(new), sessions, CODEC, blob),
+                    )
+                    conn.execute(
+                        "INSERT OR REPLACE INTO intraday_bars_cursor(ticker,last_ts,updated_at_madrid) VALUES (?,?,?)",
+                        (t, last_ts, ts_madrid_str()),
+                    )
+                    rows += 1; nbytes += len(blob)
+                ok += 1
+            except Exception as e:  # noqa: BLE001
+                failed += 1
+                if len(errors) < 20:
+                    errors.append(f"{t}: {type(e).__name__}: {str(e)[:120]}")
+            if i % 50 == 0:
+                conn.commit()
+                _log(f"velas 1m {i}/{len(tickers)} ok={ok} failed={failed} {nbytes/1e6:.1f} MB")
+        conn.commit()
+    finally:
+        conn.close()
+    status = "success" if failed == 0 else ("partial" if ok > 0 else "failed")
+    _finish_run(run_id, status, ok, failed, rows, nbytes, "; ".join(errors) if errors else None)
+    return {"run_id": run_id, "status": status, "ok": ok, "failed": failed, "rows": rows, "mb": round(nbytes / 1e6, 1)}
+
+
+# --------------------------------------------------------------------------- orchestration
+
+def _intraday_due(now: datetime) -> bool:
+    if not config.FETCH_INTRADAY_BARS:
+        return False
+    if now.weekday() in config.INTRADAY_BARS_WEEKDAYS:
+        return True
+    age = _last_success_age_days("intraday_bars_1m")
+    return age is None or age >= float(config.INTRADAY_BARS_MAX_AGE_DAYS)
+
+
+def run_flow_capture(slot_key: str, include_intraday: bool | None = None) -> dict:
+    """Ejecución completa (síncrona). La usa el hilo del daemon y ``main.py --once flow``."""
+    from tmad_client import make_client
+
+    ensure_flow_schema()
+    now = now_madrid()
+    tickers = universe_tickers()
+    out: dict = {"slot": slot_key, "tickers": len(tickers)}
+    if not tickers:
+        out["status"] = "no_universe"
+        _log("sin universo: no hay ningún Scanner con éxito en la BD")
+        return out
+    client = make_client()
+    try:
+        if config.FETCH_SCORE_REGIME and not _done("score_regime", slot_key):
+            out["score_regime"] = capture_score_regime(client, slot_key)
+        if config.FETCH_OPTION_HEATMAP and not _done("option_heatmap", slot_key):
+            _log(f"heatmap: {len(tickers)} tickers x 2 lados")
+            out["option_heatmap"] = capture_option_heatmaps(client, tickers, slot_key)
+        do_intraday = _intraday_due(now) if include_intraday is None else include_intraday
+        if do_intraday and not _done("intraday_bars_1m", slot_key):
+            _log(f"velas 1m: {len(tickers)} tickers")
+            out["intraday_bars_1m"] = capture_intraday_bars(client, tickers, slot_key)
+    finally:
+        client.close()
+    _log(f"fin {json.dumps(out, ensure_ascii=False)}")
+    return out
+
+
+def _due_slot(now: datetime) -> str | None:
+    if not config.FLOW_CAPTURE_ENABLED:
+        return None
+    current = now.hour * 60 + now.minute
+    due = []
+    for hhmm in config.FLOW_CAPTURE_TIMES:
+        try:
+            h, m = [int(x) for x in str(hhmm).split(":", 1)]
+        except Exception:
+            continue
+        if h * 60 + m <= current:
+            due.append(f"{now.strftime('%Y-%m-%d')}|{hhmm}")
+    return due[-1] if due else None
+
+
+def maybe_start_flow_capture(on_finish=None) -> bool:
+    """Lanza la captura en segundo plano si hay un slot pendiente hoy. Nunca bloquea al daemon."""
+    global _thread
+    if _thread is not None and _thread.is_alive():
+        return False
+    try:
+        ensure_flow_schema()
+        slot = _due_slot(now_madrid())
+        if not slot:
+            return False
+        pending = [k for k, on in (("score_regime", config.FETCH_SCORE_REGIME), ("option_heatmap", config.FETCH_OPTION_HEATMAP)) if on and not _done(k, slot)]
+        if _intraday_due(now_madrid()) and not _done("intraday_bars_1m", slot):
+            pending.append("intraday_bars_1m")
+        if not pending:
+            return False
+    except Exception as e:  # noqa: BLE001
+        _log(f"no se pudo comprobar el slot: {e}")
+        return False
+
+    def _worker():
+        if not _lock.acquire(blocking=False):
+            return
+        try:
+            res = run_flow_capture(slot)
+            if on_finish:
+                on_finish(res)
+        except Exception as e:  # noqa: BLE001
+            _log(f"captura de flujo falló: {e}\n{traceback.format_exc()[-1500:]}")
+        finally:
+            _lock.release()
+
+    _thread = threading.Thread(target=_worker, name="tmad-flow-capture", daemon=True)
+    _thread.start()
+    _log(f"captura de flujo lanzada en segundo plano | slot={slot} | pendiente={','.join(pending)}")
+    return True
