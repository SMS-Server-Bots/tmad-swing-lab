+def _calendar_sessions(opened_date: str, current_date: str) -> int:
+    """NYSE sessions strictly after opened_date up to and including current_date."""
+    try:
+        d = date.fromisoformat(opened_date[:10]) + timedelta(days=1)
+        end = date.fromisoformat(current_date[:10])
+    except ValueError:
+        return 0
+    n = 0
+    while d <= end:
+        if d.weekday() < 5 and d.isoformat() not in _NYSE_HOLIDAYS:
+            n += 1
+        d += timedelta(days=1)
+    return n
+
